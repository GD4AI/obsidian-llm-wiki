{
  "name": "karpathywiki",
  "version": "1.27.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Karpathy's LLM Wiki implementation - multi-page knowledge generation with conversational query",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:dev": "node esbuild.config.mjs dev",
    "lint": "eslint src/ --max-warnings=0",
    "lint:tools-bot": "eslint --config eslint.tools-bot.config.mjs tools/ --max-warnings=-1 || true",
    "css-lint": "node scripts/css-lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p tools/dev-instrument/tsconfig.json --noEmit",
    "gate:1": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm css-lint"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "llm",
    "wiki",
    "karpathy",
    "knowledge-management",
    "multi-page",
    "conversational-query",
    "streaming"
  ],
  "author": "Greener-Dalii, DocTpoint",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "16.18.126",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "ajv": "^8.20.0",
    "esbuild": "0.28.1",
    "eslint": "10.2.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-uri": "^3.1.7",
    "jsdom": "^30.0.1",
    "obsidian": "1.12.3",
    "tslib": "2.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.11",
    "yaml": "^2.4.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.98",
    "@ai-sdk/openai": "3.0.86",
    "@ai-sdk/openai-compatible": "2.0.62",
    "ai": "6.0.230",
    "fflate": "0.8.3",
    "zod": "^3.25.76"
  }
}
