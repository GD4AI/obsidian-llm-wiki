{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    // TypeScript 6 makes `strict` default to true. This project has never enabled it —
    // it picks individual flags — so the 6.0 bump would otherwise turn on
    // `strictFunctionTypes` (27 errors at variance boundaries that pass at runtime)
    // and `strictPropertyInitialization` (4 plugin fields assigned in `onload()`).
    // Writing `strict: false` and the three flags down keeps the 6.0 build identical to
    // the 5.9 one; adopting them is a separate decision, recorded in #816.
    "strict": false,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES2021",
      "ES2022.Error"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/__tests__/tools/**"
  ]
}
